# 실제 값은 .env 에. .env 는 커밋되지 않는다 (.gitignore).
# 값을 이 파일에 채워 넣지 말 것 — 키 이름과 형식만 적는다.

# ---- DB ----
# PostgreSQL 14 이상 + pgvector 확장.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dabhaejwo
POSTGRES_USER=dabhaejwo
POSTGRES_PASSWORD=

# ---- 인증 ----
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ---- 암호화 ----
# 공급사 API 키를 DB 에 암호화(AES-256-GCM)해 저장할 때 쓰는 마스터 키.
# 아무 길이의 문자열이면 된다(내부에서 SHA-256 으로 32바이트로 접는다).
# 비어 있으면 운영 콘솔의 공급사 키 등록이 거부된다.
# **바꾸면 저장된 키를 복호화할 수 없어 전부 다시 등록해야 한다.**
ENCRYPTION_KEY=

# ---- LLM 공급사 ----
# 공급사/모델/단가는 DB(model_prices)에서 관리한다.
# 자격증명도 이제 운영 콘솔(모델과 프롬프트 → 공급사 연결)에서 등록한다 —
# 노출된 키를 재배포 없이 교체할 수 있어야 하기 때문이다.
#
# 아래 값은 **콘솔에 등록된 키가 없을 때만 쓰이는 대체 경로**다. 콘솔 등록분이 우선한다.
# 새로 구축하는 환경이라면 비워두고 콘솔에서 등록하는 편이 낫다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 파일 저장소 (S3 호환 — Cloudflare R2 등) ----
# 비워두면 업로드가 FEATURE_NOT_READY 로 명시적으로 거절된다. 조용히 로컬에 쓰지 않는다.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- 포트 ----
# api 4310 / admin 4311 / tenant 4312
SERVER_PORT=4310

# ---- CORS ----
# 브라우저에서 API 를 부르는 출처. 여기 없으면 브라우저 요청이 막힌다(curl 은 영향 없음).
# 위젯 경로(/api/widget)는 남의 사이트에서 호출되므로 이 목록과 무관하게 열려 있고,
# 실제 차단은 테넌트의 등록 주소로 서버가 한다.
CORS_ALLOWED_ORIGINS=http://localhost:4311,http://localhost:4312,http://localhost:5173

# ---- 프론트 (빌드 시점에 번들로 인라인된다) ----
# **런타임에 못 바꾼다.** 컨테이너 환경변수를 고쳐도 아무 일도 일어나지 않는다 —
# 값을 바꾸려면 다시 빌드해야 한다. 운영에서는 CI 가 build-arg 로 주입한다
# (docs/deploy/README.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4310
# 설치 화면이 업체에게 보여줄 스크립트 주소. 파일명(w.js)까지 포함한 전체 URL이다.
NEXT_PUBLIC_WIDGET_SRC=http://localhost:5173/w.js
# 위젯 번들에 박히는 API 주소. 호스트 사이트는 키만 적으면 되므로
# 위젯이 자기가 어디로 물어볼지 알고 있어야 한다.
VITE_API_BASE_URL=http://localhost:4310

# ---- 알림 (stub) ----
SLACK_OPS_WEBHOOK_URL=

# ---- 메일 (SMTP) ----
# Gmail 은 계정 비밀번호가 아니라 앱 비밀번호를 쓴다(2단계 인증 필요).
# 비어 있으면 메일 발송이 거부된다 — 조용히 성공 처리하지 않는다.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=답해줘
# 초대·비밀번호 재설정 링크가 가리킬 곳
APP_BASE_URL=http://localhost:4312
# 로컬 운영자 시드 계정의 주소. 로그인 2단계 코드가 여기로 오므로 실제 사서함이어야 한다.
OPS_SEED_EMAIL=

# 토스페이먼츠 (PG). 결제 연동 마일스톤에서 사용한다.
# 시크릿 키는 서버 전용이다 — 프론트로 내보내지 않는다. 운영은 라이브 키.
# 결제창 키. 공개돼도 되는 값이지만 **tenant/.env.local 에 둔다** —
# Next 개발 서버는 이 파일을 읽지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SECURITY_KEY=
# 개발 중 로그인 인증 코드를 검사하지 않는다(6자리면 통과). 운영에는 절대 넣지 않는다.
OTP_DEV_ACCEPT_ANY=false
