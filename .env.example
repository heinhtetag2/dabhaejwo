# 실제 값은 .env 에. .env 는 커밋되지 않는다 (.gitignore).
# 값을 이 파일에 채워 넣지 말 것 — 키 이름과 형식만 적는다.

# ---- DB ----
# PostgreSQL 14 이상 + pgvector 확장.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dabhaejwo
POSTGRES_USER=dabhaejwo
POSTGRES_PASSWORD=

# ---- 인증 ----
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# ---- LLM 공급사 ----
# 공급사/모델/단가는 DB(model_prices)에서 관리한다. 여기에는 자격증명만 둔다.
# 사용하지 않는 공급사의 키는 비워두면 해당 provider 가 비활성화된다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- 파일 저장소 (S3 호환 — Cloudflare R2 등) ----
# 비워두면 업로드가 FEATURE_NOT_READY 로 명시적으로 거절된다. 조용히 로컬에 쓰지 않는다.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- 포트 ----
# api 4310 / admin 4311 / tenant 4312
SERVER_PORT=4310

# ---- CORS ----
# 브라우저에서 API 를 부르는 출처. 여기 없으면 브라우저 요청이 막힌다(curl 은 영향 없음).
# 위젯 경로(/api/widget)는 남의 사이트에서 호출되므로 이 목록과 무관하게 열려 있고,
# 실제 차단은 테넌트의 등록 주소로 서버가 한다.
CORS_ALLOWED_ORIGINS=http://localhost:4311,http://localhost:4312,http://localhost:5173

# ---- 프론트 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4310
NEXT_PUBLIC_WIDGET_CDN_URL=http://localhost:5173

# ---- 알림 (stub) ----
SLACK_OPS_WEBHOOK_URL=
