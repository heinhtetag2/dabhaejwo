# ---- 비밀 ----
.env
.env.*
!.env.example
# application-local.yml 은 추적한다 — 자리표시자와 localhost 기본값만 들어간다.
# 비밀을 파일로 두어야 하면 아래 이름을 쓴다.
**/application-secret.yml

# ---- Node ----
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
npm-debug.log*
yarn-error.log*

# ---- Java / Gradle ----
.gradle/
!gradle/wrapper/gradle-wrapper.jar
api/build/
api/bin/
*.class

# ---- IDE ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- 런타임 산출물 ----
*.log
coverage/
playwright-report/
test-results/

# 자격증명 메모. 이 프로젝트에서 두 번 커밋됐다 (ai-info.md, r2-info.md).
# docs/ 는 커밋 대상이라 이런 파일이 git add -A 에 쓸려 들어간다.
docs/*-info.md
